<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".FahrenheitActivity" android:background="#CCF4F2">


    <Button android:id="@+id/btn"
            android:layout_width="171dp"
            android:layout_height="58dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="216dp"
            android:layout_marginEnd="36dp"
            android:text="Convert"
            android:textSize="24sp"
            app:backgroundTint="#CC1146"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_bias="0.0"
            android:background="#E0167E"/>
    <Button android:id="@+id/btn2"
            android:layout_width="302dp"
            android:layout_height="66dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="376dp"
            android:layout_marginEnd="36dp"
            android:text="Celsius to Fahrenheit"
            android:textSize="24sp"
            app:backgroundTint="#CC1146"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_bias="0.0"
            android:background="#E0167E"/>
    <EditText
            android:id="@+id/editTextFahrenheit"
            android:layout_width="405dp"
            android:layout_height="66dp"
            android:hint="Enter temperature in Fahrenheit"
            android:textSize="25sp"
            android:backgroundTint="#EDE9E9"
            android:inputType="numberDecimal"
            android:background="#DE1077"
            android:textColor="#EF0C0C"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" android:layout_marginTop="136dp"
            app:layout_constraintHorizontal_bias="0.166"/>
    <TextView android:id="@+id/tv"
              android:layout_width="291dp"
              android:layout_height="49dp"
              android:layout_marginStart="36dp"
              android:layout_marginTop="40dp"
              android:layout_marginEnd="36dp"
              android:text="Fahrenheit to Celsius"
              android:textSize="30sp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_bias="0.0"
              android:textAppearance="@style/TextAppearance.AppCompat.Body2" android:background="#14D4E6"
              android:textStyle="bold|italic"/>
    <TextView android:id="@+id/tv1"
              android:layout_width="219dp"
              android:layout_height="51dp"
              android:layout_marginStart="36dp"
              android:layout_marginTop="292dp"
              android:layout_marginEnd="36dp"
              android:text="Final Answer "
              android:textSize="35sp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent" app:layout_constraintHorizontal_bias="0.0"
              android:background="#F2EEEE" android:textAppearance="@style/TextAppearance.AppCompat.Display4"
              android:textStyle="italic" android:textColor="#F00B0B"/>

</androidx.constraintlayout.widget.ConstraintLayout>

